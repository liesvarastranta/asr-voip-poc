# ASR Service
ASR_MODEL_ID=small
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
ASR_CHUNK_MS=500
ASR_SAMPLE_RATE=16000

# LLM Service
LLM_MODEL_ID=meta-llama/Llama-3.2-1B-Instruct
LLM_GGUF_REPO=bartowski/Llama-3.2-1B-Instruct-GGUF
LLM_GGUF_FILENAME=Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLM_HOST=0.0.0.0
LLM_PORT=18002
LLM_N_GPU_LAYERS=-1
LLM_N_CTX=4096

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent endpoints
ASR_ENDPOINT=http://localhost:18001
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
VLLM_ENDPOINT=http://localhost:18002/v1
TTS_ENDPOINT=http://localhost:18003

# ASR: Groq Whisper (cloud, free tier) — set ASR_ENDPOINT + ASR_API_KEY below.
# Auto-detects OpenAI-compatible host (groq.com / openai.com) when ASR_API_KEY is set.
# Example: ASR_ENDPOINT=https://api.groq.com/openai/v1
#           ASR_API_KEY=gsk_...
#           ASR_MODEL=whisper-large-v3

# LLM via Bifrost gateway (Gemma 4 / llama.cpp, remote, OpenAI-compatible)
BIFROST_URL=https://bifrost.hcm-lab.id/v1
BIFROST_API_KEY=REPLACE_WITH_BIFROST_API_KEY
BIFROST_MODEL=llama.cpp/gemma-4-12b-it-q8
