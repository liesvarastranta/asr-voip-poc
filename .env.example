# ASR Service
ASR_MODEL_ID=small
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
ASR_CHUNK_MS=500
ASR_SAMPLE_RATE=16000

# LLM Service
LLM_MODEL_ID=meta-llama/Llama-3.2-1B-Instruct
LLM_GGUF_REPO=bartowski/Llama-3.2-1B-Instruct-GGUF
LLM_GGUF_FILENAME=Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLM_HOST=0.0.0.0
LLM_PORT=18002
LLM_N_GPU_LAYERS=-1
LLM_N_CTX=4096

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent endpoints
ASR_ENDPOINT=http://localhost:18001
VLLM_ENDPOINT=http://localhost:18002/v1
TTS_ENDPOINT=http://localhost:18003
